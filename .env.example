# ===== Mesa de Servicios ADUCORP · variables de Docker Compose =====
# Copie a .env y reemplace TODOS los valores CAMBIAR.

VERSION=latest
REGISTRO=aducorp
WEB_PUERTO=8080

# --- SQL Server
SA_PASSWORD=CAMBIAR_Sa#2026_Larga
MSSQL_PID=Developer              # Standard o Enterprise con licencia en producción
DB_NAME=AducorpMesaServicios
DB_APP_USER=mesa_app
DB_APP_PASSWORD=CAMBIAR_App-2026_Larga     # sin @ / ? # porque va dentro de la URL de conexión

# --- Aplicación
APP_ENV=production
APP_URL=https://mesa.aducorp.com.ec
CORS_ORIGINS=["https://mesa.aducorp.com.ec"]
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CAMBIAR
DOCS_ENABLED=true

# --- Autenticación: local | ldap (Active Directory) | entra (Microsoft 365)
AUTH_PROVIDER=local
LDAP_URL=ldaps://dc01.aducorp.local:636
LDAP_DOMINIO=ADUCORP
LDAP_BASE_DN=DC=aducorp,DC=local
LDAP_USUARIO_SERVICIO=
LDAP_CLAVE_SERVICIO=
LDAP_GRUPO_ROLES={}

# --- Microsoft 365 (ver docs/10-microsoft-365.md). Una sola aplicación registrada en Entra ID.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
# Entra ID: AUTH_PROVIDER=entra activa el inicio de sesión con Microsoft (sin contraseñas locales)
ENTRA_GRUPO_ROLES={}
ENTRA_ROL_DEFECTO=CLIENTE
ENTRA_EXIGIR_MFA=false
ENTRA_CUENTAS_EMERGENCIA=[]
ENTRA_SYNC_MINUTOS=60
# Exchange Online: buzón compartido que crea tickets y envía los avisos (EMAIL_TRANSPORTE=graph)
BUZON_ENABLED=false
BUZON_CORREO=soporte@aducorp.com.ec
BUZON_DOMINIOS_INTERNOS=["aducorp.com.ec"]
EMAIL_TRANSPORTE=smtp
# Microsoft Teams: bot con tarjetas adaptables y acciones
TEAMS_ENABLED=false

# --- Correo
EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=mesa.servicios@aducorp.com.ec
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Publicación en internet con Cloudflare Tunnel (docs/11-publicar-en-internet.md)
# Token del túnel permanente; con él APP_URL debe ser la dirección pública, p. ej. https://mesa.aducorp.com.ec
CLOUDFLARE_TUNNEL_TOKEN=

# --- IA (local | llm). "llm" envía datos del ticket a la API de Anthropic.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
