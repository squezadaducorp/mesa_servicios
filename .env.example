# ===== Mesa de Servicios ADUCORP · variables de Docker Compose =====
# Copie a .env y reemplace TODOS los valores CAMBIAR.

VERSION=latest
REGISTRO=aducorp
WEB_PUERTO=8080

# --- SQL Server
SA_PASSWORD=CAMBIAR_Sa#2026_Larga
MSSQL_PID=Developer              # Standard o Enterprise con licencia en producción
DB_NAME=AducorpMesaServicios
DB_APP_USER=mesa_app
DB_APP_PASSWORD=CAMBIAR_App-2026_Larga     # sin @ / ? # porque va dentro de la URL de conexión

# --- Aplicación
APP_ENV=production
APP_URL=https://mesa.aducorp.com.ec
CORS_ORIGINS=["https://mesa.aducorp.com.ec"]
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CAMBIAR
DOCS_ENABLED=true

# --- Active Directory (AUTH_PROVIDER=ldap para activarlo)
AUTH_PROVIDER=local
LDAP_URL=ldaps://dc01.aducorp.local:636
LDAP_DOMINIO=ADUCORP
LDAP_BASE_DN=DC=aducorp,DC=local
LDAP_USUARIO_SERVICIO=
LDAP_CLAVE_SERVICIO=
LDAP_GRUPO_ROLES={}

# --- Correo
EMAIL_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=mesa.servicios@aducorp.com.ec
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- IA (local | llm). "llm" envía datos del ticket a la API de Anthropic.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
